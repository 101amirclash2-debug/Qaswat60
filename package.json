{
  "name": "tijara-card-game",
  "version": "1.0.0",
  "private": true,
  "description": "تجارة — لعبة ورق اجتماعية عربية لأندرويد (APK + ويب + غرف شبكية)",
  "scripts": {
    "dev": "node server/server.mjs",
    "start": "node server/server.mjs",
    "test": "node --test tests/*.test.mjs",
